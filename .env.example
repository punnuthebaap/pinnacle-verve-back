APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pinnacle?sslmode=disable
AUTO_MIGRATE=true
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-mock-secret
# Unconfirmed commercial values (ROADMAP B4)
WHITE_GLOVE_THRESHOLD_PAISE=1500000
SHIPPING_PAISE=0
ADDON_GST_RATE_BPS=1800
ENABLED_PAYMENT_METHODS=upi,card,netbanking,emi
# Unpaid orders are cancelled and stock released after this many minutes
PENDING_ORDER_TTL_MINUTES=30
# Storefront cache revalidation after admin catalogue edits (same secret in the storefront env)
STOREFRONT_REVALIDATE_URL=http://localhost:3000/internal/revalidate
REVALIDATE_SECRET=dev-revalidate-secret
# Uploaded product images (local disk until a bucket is configured)
MEDIA_DIR=.local/media
